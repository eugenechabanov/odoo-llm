<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_form2_inherit_llm_agent_crewai" model="ir.ui.view">
        <field name="name">project.task.form.inherit.llm.agent.crewai</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <!-- Add AI execution button -->
            <xpath expr="//header" position="inside">
                <button name="action_execute_ai_task" 
                        string="Execute AI Task" 
                        type="object"
                        class="oe_highlight"
                        attrs="{'invisible': [('is_ai_executable', '=', False)]}"/>
            </xpath>

            <!-- Add AI configuration notebook page -->
            <xpath expr="//notebook" position="inside">
                <page string="AI Configuration" name="ai_configuration">
                    <group>
                        <group>
                            <field name="is_ai_executable"/>
                            <field name="process"/>
                            <field name="expected_output"/>
                        </group>
                        <group>
                            <field name="execution_time" readonly="1"/>
                            <field name="ai_result" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
