<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_form2_inherit_llm_agent_crewai" model="ir.ui.view">
        <field name="name">project.task.form.inherit.llm.agent.crewai</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <!-- Add AI execution button -->
            <xpath expr="//header" position="inside">
                <button name="action_execute_ai_task" 
                        string="Execute AI Task" 
                        type="object"
                        class="oe_highlight"
                        attrs="{'invisible': [('is_ai_executable', '=', False)]}"/>
            </xpath>

            <!-- Add AI configuration notebook page -->
            <xpath expr="//notebook" position="inside">
                <page string="AI Configuration" name="ai_configuration">
                    <group>
                        <group>
                            <field name="is_ai_executable"/>
                            <field name="process"/>
                            <field name="expected_output"/>
                        </group>
                        <group>
                            <field name="execution_time" readonly="1"/>
                            <field name="ai_result" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Add AI fields to task kanban view -->
    <record id="view_task_kanban_inherit_llm_agent_crewai" model="ir.ui.view">
        <field name="name">project.task.kanban.inherit.llm.agent.crewai</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_ids']" position="after">
                <field name="is_ai_executable"/>
                <field name="process"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_kanban_bottom_left')]" position="inside">
                <div t-if="record.is_ai_executable.raw_value" class="ml-2">
                    <i class="fa fa-robot" title="AI Executable"/>
                    <span class="ml-1" t-esc="record.process.value"/>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Add AI fields to task search view -->
    <record id="view_task_search_form_inherit_llm_agent_crewai" model="ir.ui.view">
        <field name="name">project.task.search.inherit.llm.agent.crewai</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_tasks']" position="after">
                <filter string="AI Executable" name="ai_executable" 
                        domain="[('is_ai_executable', '=', True)]"/>
                <separator/>
                <filter string="Sequential Tasks" name="sequential_tasks" 
                        domain="[('process', '=', 'sequential')]"/>
                <filter string="Hierarchical Tasks" name="hierarchical_tasks" 
                        domain="[('process', '=', 'hierarchical')]"/>
            </xpath>
        </field>
    </record>
</odoo>
