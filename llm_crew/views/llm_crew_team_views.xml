<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="llm_crew_team_view_tree" model="ir.ui.view">
        <field name="name">llm.crew.team.tree</field>
        <field name="model">llm.crew.team</field>
        <field name="arch" type="xml">
            <tree string="AI Crews">
                <field name="name"/>
                <field name="team_id"/>
                <field name="project_id"/>
                <field name="process"/>
                <field name="manager_id"/>
                <field name="llm_enabled"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="llm_crew_team_view_form" model="ir.ui.view">
        <field name="name">llm.crew.team.form</field>
        <field name="model">llm.crew.team</field>
        <field name="arch" type="xml">
            <form string="AI Crew">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- Add buttons here if needed -->
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="team_id"/>
                            <field name="project_id" attrs="{'readonly': [('task_ids', '!=', False)]}"/>
                            <field name="llm_enabled"/>
                        </group>
                        <group>
                            <field name="process"/>
                            <field name="manager_id" 
                                   attrs="{'invisible': [('process', '!=', 'hierarchical')],
                                         'required': [('process', '=', 'hierarchical')]}"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tasks" name="tasks">
                            <field name="task_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="user_id"/>
                                    <field name="stage_id"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="llm_crew_team_view_search" model="ir.ui.view">
        <field name="name">llm.crew.team.search</field>
        <field name="model">llm.crew.team</field>
        <field name="arch" type="xml">
            <search string="Search AI Crews">
                <field name="name"/>
                <field name="team_id"/>
                <field name="project_id"/>
                <field name="manager_id"/>
                <separator/>
                <filter string="Enabled" name="enabled" domain="[('llm_enabled', '=', True)]"/>
                <filter string="Disabled" name="disabled" domain="[('llm_enabled', '=', False)]"/>
                <separator/>
                <filter string="Sequential" name="sequential" domain="[('process', '=', 'sequential')]"/>
                <filter string="Hierarchical" name="hierarchical" domain="[('process', '=', 'hierarchical')]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Team" name="group_team" context="{'group_by': 'team_id'}"/>
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Process" name="group_process" context="{'group_by': 'process'}"/>
                    <filter string="Manager" name="group_manager" context="{'group_by': 'manager_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_llm_crew_team" model="ir.actions.act_window">
        <field name="name">AI Crews</field>
        <field name="res_model">llm.crew.team</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_enabled': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first AI crew!
            </p>
            <p>
                AI crews help organize and manage AI-powered tasks within projects.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_llm_crew_team"
              name="AI Crews"
              parent="llm.menu_llm_root"
              action="action_llm_crew_team"
              sequence="20"/>
</odoo>
