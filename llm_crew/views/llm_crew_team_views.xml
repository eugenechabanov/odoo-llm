<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="llm_crew_team_view_tree" model="ir.ui.view">
        <field name="name">llm.crew.team.tree</field>
        <field name="model">llm.crew.team</field>
        <field name="arch" type="xml">
            <tree string="AI Crews">
                <field name="name"/>
                <field name="team_id"/>
                <field name="process"/>
                <field name="manager_id"/>
                <field name="llm_enabled"/>
                <field name="llm_provider_id"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="llm_crew_team_view_form" model="ir.ui.view">
        <field name="name">llm.crew.team.form</field>
        <field name="model">llm.crew.team</field>
        <field name="arch" type="xml">
            <form string="AI Crew">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="team_id"/>
                            <field name="process"/>
                            <field name="manager_id" 
                                   attrs="{'invisible': [('process', '!=', 'hierarchical')],
                                         'required': [('process', '=', 'hierarchical')]}"/>
                        </group>
                        <group>
                            <field name="llm_enabled"/>
                            <field name="llm_provider_id" attrs="{'required': [('llm_enabled', '=', True)]}"/>
                            <field name="llm_model_id" attrs="{'required': [('llm_enabled', '=', True)]}"/>
                            <field name="llm_memory_enabled"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tasks" name="tasks">
                            <field name="task_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="user_id"/>
                                    <field name="stage_id"/>
                                    <field name="llm_enabled"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Memory" name="memory" attrs="{'invisible': [('llm_memory_enabled', '=', False)]}">
                            <field name="llm_memory_config" widget="ace" options="{'mode': 'json'}" placeholder="{&#10;  // JSON configuration for LLM memory&#10;}"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="llm_crew_team_view_search" model="ir.ui.view">
        <field name="name">llm.crew.team.search</field>
        <field name="model">llm.crew.team</field>
        <field name="arch" type="xml">
            <search string="AI Crews">
                <field name="name"/>
                <field name="team_id"/>
                <field name="process"/>
                <field name="manager_id"/>
                <field name="llm_provider_id"/>
                <separator/>
                <filter string="Enabled" name="enabled" domain="[('llm_enabled', '=', True)]"/>
                <filter string="Disabled" name="disabled" domain="[('llm_enabled', '=', False)]"/>
                <separator/>
                <filter string="Hierarchical" name="hierarchical" domain="[('process', '=', 'hierarchical')]"/>
                <filter string="Sequential" name="sequential" domain="[('process', '=', 'sequential')]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Process" name="group_by_process" context="{'group_by': 'process'}"/>
                    <filter string="Provider" name="group_by_provider" context="{'group_by': 'llm_provider_id'}"/>
                    <filter string="Model" name="group_by_model" context="{'group_by': 'llm_model_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="llm_crew_team_action" model="ir.actions.act_window">
        <field name="name">AI Crews</field>
        <field name="res_model">llm.crew.team</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="llm_crew_team_view_search"/>
        <field name="context">{'search_default_enabled': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first AI crew!
            </p>
            <p>
                AI crews can be configured to perform various tasks using LLM capabilities.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_llm_crew_team"
              name="AI Crews"
              parent="llm.menu_llm_root"
              action="llm_crew_team_action"
              sequence="10"/>
</odoo>
