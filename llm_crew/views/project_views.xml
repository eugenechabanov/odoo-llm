<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Project Form View -->
    <record id="project_form_view_inherit_llm_crew" model="ir.ui.view">
        <field name="name">project.project.form.inherit.llm.crew</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_crews"
                        icon="fa-users" attrs="{'invisible': [('crew_count', '=', 0)]}">
                    <field name="crew_count" widget="statinfo" string="AI Crews"/>
                </button>
            </div>
            <notebook position="inside">
                <page string="AI Crews" name="ai_crews">
                    <field name="crew_team_ids" nolabel="1">
                        <tree>
                            <field name="name"/>
                            <field name="team_id"/>
                            <field name="process"/>
                            <field name="manager_id"/>
                            <field name="llm_enabled"/>
                        </tree>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

    <!-- Project Kanban View -->
    <record id="project_kanban_view_inherit_llm_crew" model="ir.ui.view">
        <field name="name">project.project.kanban.inherit.llm.crew</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="crew_count"/>
            </field>
            <xpath expr="//div[hasclass('o_project_kanban_boxes')]" position="inside">
                <div t-if="record.crew_count.raw_value" class="o_project_kanban_box">
                    <a name="action_view_crews" type="object">
                        <span class="o_value"><t t-esc="record.crew_count.value"/></span>
                        <span class="o_label">AI Crews</span>
                    </a>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
