<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Inherit Form View -->
    <record id="view_task_form2_inherit_crew" model="ir.ui.view">
        <field name="name">project.task.form.inherit.crew</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_ids']" position="after">
                <field name="can_execute_ai" invisible="1"/>
                <field name="process"/>
                <field name="expected_output"/>
                <field name="ai_result" readonly="1"/>
                <field name="execution_time" readonly="1" widget="float_time"/>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_execute_ai_task" 
                        string="Execute AI Task" 
                        type="object" 
                        class="oe_highlight"
                        attrs="{'invisible': [('can_execute_ai', '=', False)]}"/>
            </xpath>
        </field>
    </record>
</odoo>
