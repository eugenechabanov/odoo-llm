<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_form2_llm" model="ir.ui.view">
        <field name="name">project.task.form.llm</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="AI Task" attrs="{'invisible': [('is_ai_task', '=', False)]}">
                    <group>
                        <field name="is_ai_task"/>
                        <field name="llm_crew_task_id" attrs="{'required': [('is_ai_task', '=', True)]}"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
