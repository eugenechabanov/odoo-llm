<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Form View -->
    <record id="view_task_form2_inherit_crew" model="ir.ui.view">
        <field name="name">project.task.form.inherit.crew</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_ids']" position="after">
                <field name="is_crew_task"/>
                <field name="expected_output" attrs="{'invisible': [('is_crew_task', '=', False)]}"/>
            </xpath>
        </field>
    </record>
</odoo>
