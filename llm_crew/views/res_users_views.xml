<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_llm" model="ir.ui.view">
        <field name="name">res.users.form.llm</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="AI Agent" attrs="{'invisible': [('is_ai_agent', '=', False)]}">
                    <group>
                        <field name="is_ai_agent"/>
                        <field name="llm_crew_agent_id" attrs="{'required': [('is_ai_agent', '=', True)]}"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <!-- Add LLM column to user tree view -->
    <record id="view_users_tree_llm" model="ir.ui.view">
        <field name="name">res.users.tree.llm</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_tree"/>
        <field name="arch" type="xml">
            <field name="login" position="after">
                <field name="is_ai_agent" optional="show"/>
                <field name="llm_crew_agent_id" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
