<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="llm_crew_agent_view_tree" model="ir.ui.view">
        <field name="name">llm.crew.agent.tree</field>
        <field name="model">llm.crew.agent</field>
        <field name="arch" type="xml">
            <tree string="AI Agents">
                <field name="name"/>
                <field name="role"/>
                <field name="user_id"/>
                <field name="llm_enabled"/>
                <field name="llm_provider_id"/>
                <field name="allow_delegation"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="llm_crew_agent_view_form" model="ir.ui.view">
        <field name="name">llm.crew.agent.form</field>
        <field name="model">llm.crew.agent</field>
        <field name="arch" type="xml">
            <form string="AI Agent">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="role"/>
                            <field name="goal"/>
                            <field name="allow_delegation"/>
                        </group>
                        <group>
                            <field name="llm_enabled"/>
                            <field name="llm_provider_id" attrs="{'required': [('llm_enabled', '=', True)]}"/>
                            <field name="llm_model_id" attrs="{'required': [('llm_enabled', '=', True)]}"/>
                            <field name="llm_memory_enabled"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Backstory" name="backstory">
                            <field name="backstory" placeholder="Provide background context for the agent..."/>
                        </page>
                        <page string="Tools" name="tools">
                            <field name="tools" widget="ace" options="{'mode': 'json'}" placeholder="{&#10;  // JSON configuration for agent tools&#10;}"/>
                        </page>
                        <page string="Memory" name="memory" attrs="{'invisible': [('llm_memory_enabled', '=', False)]}">
                            <field name="llm_memory_config" widget="ace" options="{'mode': 'json'}" placeholder="{&#10;  // JSON configuration for LLM memory&#10;}"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="llm_crew_agent_view_search" model="ir.ui.view">
        <field name="name">llm.crew.agent.search</field>
        <field name="model">llm.crew.agent</field>
        <field name="arch" type="xml">
            <search string="AI Agents">
                <field name="name"/>
                <field name="role"/>
                <field name="user_id"/>
                <field name="llm_provider_id"/>
                <separator/>
                <filter string="Enabled" name="enabled" domain="[('llm_enabled', '=', True)]"/>
                <filter string="Disabled" name="disabled" domain="[('llm_enabled', '=', False)]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Provider" name="group_by_provider" context="{'group_by': 'llm_provider_id'}"/>
                    <filter string="Model" name="group_by_model" context="{'group_by': 'llm_model_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="llm_crew_agent_action" model="ir.actions.act_window">
        <field name="name">AI Agents</field>
        <field name="res_model">llm.crew.agent</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="llm_crew_agent_view_search"/>
        <field name="context">{'search_default_enabled': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first AI agent!
            </p>
            <p>
                AI agents can be configured to perform various tasks using LLM capabilities.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_llm_crew_agent"
              name="AI Agents"
              parent="llm.menu_llm_root"
              action="llm_crew_agent_action"
              sequence="20"/>
</odoo>
