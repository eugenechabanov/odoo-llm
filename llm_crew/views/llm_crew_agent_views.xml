<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_llm_crew_agent_tree" model="ir.ui.view">
        <field name="name">llm.crew.agent.tree</field>
        <field name="model">llm.crew.agent</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="user_id"/>
                <field name="role"/>
                <field name="llm_provider_id"/>
                <field name="llm_model_id"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_llm_crew_agent_form" model="ir.ui.view">
        <field name="name">llm.crew.agent.form</field>
        <field name="model">llm.crew.agent</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Agent Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="llm_provider_id"/>
                            <field name="llm_model_id"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Agent Configuration" name="configuration">
                            <group>
                                <field name="role"/>
                                <field name="goal"/>
                                <field name="backstory"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_llm_crew_agent_search" model="ir.ui.view">
        <field name="name">llm.crew.agent.search</field>
        <field name="model">llm.crew.agent</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_id"/>
                <field name="role"/>
                <field name="llm_provider_id"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_llm_crew_agent" model="ir.actions.act_window">
        <field name="name">AI Agents</field>
        <field name="res_model">llm.crew.agent</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_llm_crew_agent_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first AI agent!
            </p>
        </field>
    </record>
</odoo>
