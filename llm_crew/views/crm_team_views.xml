<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Form View -->
    <record id="crm_team_view_form_inherit_crew" model="ir.ui.view">
        <field name="name">crm.team.form.inherit.crew</field>
        <field name="model">crm.team</field>
        <field name="inherit_id" ref="sales_team.crm_team_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="AI Crew" name="ai_crew">
                    <group>
                        <field name="is_crew"/>
                        <field name="project_id" attrs="{'invisible': [('is_crew', '=', False)], 'required': [('is_crew', '=', True)]}"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
