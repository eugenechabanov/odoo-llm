<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="llm_agent_tool_provider_view_form" model="ir.ui.view">
        <field name="name">llm.agent.tool.provider.view.form</field>
        <field name="model">llm.agent.tool.provider</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options="{&quot;terminology&quot;: &quot;archive&quot;}"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Tool Provider Name"/>
                        </h1>
                    </div>
                    <group>
                        <group name="main">
                            <field name="description"/>
                        </group>
                        <group name="settings">
                            <field name="service"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tools" name="tools">
                            <field name="tool_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="llm_agent_tool_provider_view_tree" model="ir.ui.view">
        <field name="name">llm.agent.tool.provider.view.tree</field>
        <field name="model">llm.agent.tool.provider</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="description"/>
                <field name="service"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Search View -->
    <record id="llm_agent_tool_provider_view_search" model="ir.ui.view">
        <field name="name">llm.agent.tool.provider.view.search</field>
        <field name="model">llm.agent.tool.provider</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="description"/>
                <field name="service"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Service" name="group_by_service" domain="[]" context="{'group_by': 'service'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="llm_agent_tool_provider_action" model="ir.actions.act_window">
        <field name="name">Tool Providers</field>
        <field name="res_model">llm.agent.tool.provider</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first tool provider!
            </p>
            <p>
                Tool providers offer collections of tools that can be used by agents.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="llm_agent_tool_provider_menu"
              name="Tool Providers"
              parent="llm_agent_menu_root"
              action="llm_agent_tool_provider_action"
              sequence="15"/>
</odoo> 