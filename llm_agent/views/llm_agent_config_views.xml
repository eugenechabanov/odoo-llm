<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_llm_agent_config_tree" model="ir.ui.view">
        <field name="name">llm.agent.config.tree</field>
        <field name="model">llm.agent.config</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="user_id"/>
                <field name="role"/>
                <field name="is_active"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_llm_agent_config_form" model="ir.ui.view">
        <field name="name">llm.agent.config.form</field>
        <field name="model">llm.agent.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Technical Lead Agent"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="role"/>
                            <field name="model_id"/>
                            <field name="is_active"/>
                        </group>
                        <group>
                            <field name="goal"/>
                            <field name="backstory"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="System Prompt" name="system_prompt">
                            <field name="system_prompt"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_llm_agent_config_search" model="ir.ui.view">
        <field name="name">llm.agent.config.search</field>
        <field name="model">llm.agent.config</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_id"/>
                <field name="role"/>
                <separator/>
                <filter string="Active" name="active" domain="[('is_active', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Role" name="group_role" context="{'group_by': 'role'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_llm_agent_config" model="ir.actions.act_window">
        <field name="name">Agent Configurations</field>
        <field name="res_model">llm.agent.config</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first agent configuration!
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_llm_agent_config"
              name="Agent Configurations"
              parent="llm.menu_llm_root"
              action="action_llm_agent_config"
              sequence="20"/>
</odoo>
