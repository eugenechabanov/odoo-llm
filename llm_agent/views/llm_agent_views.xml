<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Tree View -->
    <record id="view_llm_agent_tree" model="ir.ui.view">
        <field name="name">llm.agent.tree</field>
        <field name="model">llm.agent</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="user_id" />
                <field name="role" />
                <field name="parent_id" />
                <field name="is_manager" />
                <field name="allow_delegation" />
                <field name="allow_odoo_tools" />
                <field name="llm_provider_id" />
                <field name="llm_model_id" />
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_llm_agent_form" model="ir.ui.view">
        <field name="name">llm.agent.form</field>
        <field name="model">llm.agent</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Agent Name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id" />
                            <field name="llm_provider_id" />
                            <field name="llm_model_id" />
                            <field name="active" widget="boolean_toggle" />
                        </group>
                        <group>
                            <field
                name="parent_id"
                domain="[('id', '!=', id), ('parent_id', '=', False)]"
              />
                            <field name="is_manager" />
                            <field name="allow_delegation" />
                            <field name="allow_odoo_tools" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Agent Configuration" name="configuration">
                            <group>
                                <field name="role" />
                                <field name="goal" />
                                <field name="backstory" />
                            </group>
                        </page>
                        <page
              string="Team Members"
              name="team_members"
              attrs="{'invisible': [('is_manager', '=', False)]}"
            >
                            <field
                name="member_ids"
                domain="[('parent_id', '=', False)]"
                context="{'default_parent_id': id}"
              >
                                <tree editable="bottom">
                                    <field name="name" />
                                    <field name="user_id" />
                                    <field name="role" />
                                    <field name="allow_delegation" />
                                    <field name="allow_odoo_tools" />
                                    <field name="llm_provider_id" />
                                    <field name="llm_model_id" />
                                    <field
                    name="active"
                    widget="boolean_toggle"
                  />
                                </tree>
                                <form>
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="name" />
                                                <field name="user_id" />
                                                <field name="llm_provider_id" />
                                                <field name="llm_model_id" />
                                                <field
                          name="active"
                          widget="boolean_toggle"
                        />
                                            </group>
                                            <group>
                                                <field name="role" />
                                                <field name="goal" />
                                                <field name="backstory" />
                                                <field
                          name="allow_delegation"
                        />
                                                <field
                          name="allow_odoo_tools"
                        />
                                            </group>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_llm_agent_search" model="ir.ui.view">
        <field name="name">llm.agent.search</field>
        <field name="model">llm.agent</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="user_id" />
                <field name="role" />
                <field name="parent_id" />
                <field name="llm_provider_id" />
                <separator />
                <filter
          string="Managers"
          name="managers"
          domain="[('is_manager', '=', True)]"
        />
                <filter
          string="Can Delegate"
          name="can_delegate"
          domain="[('allow_delegation', '=', True)]"
        />
                <filter
          string="Team Members"
          name="members"
          domain="[('parent_id', '!=', False)]"
        />
                <filter
          string="Archived"
          name="inactive"
          domain="[('active', '=', False)]"
        />
                <group expand="0" string="Group By">
                    <filter
            string="Manager"
            name="group_by_manager"
            context="{'group_by': 'parent_id'}"
          />
                    <filter
            string="Provider"
            name="group_by_provider"
            context="{'group_by': 'llm_provider_id'}"
          />
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_llm_agent" model="ir.actions.act_window">
        <field name="name">AI Agents</field>
        <field name="res_model">llm.agent</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_llm_agent_search" />
        <field name="context">{'default_active': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first AI agent!
            </p>
        </field>
    </record>
</odoo>
