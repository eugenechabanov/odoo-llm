<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Record Rules for Long Term Memory -->
    <record id="rule_llm_memory_long_term_agent" model="ir.rule">
        <field name="name">LLM Long Term Memory: Agents see only their own memories</field>
        <field name="model_id" ref="model_llm_memory_long_term"/>
        <field name="domain_force">[('agent_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('llm_agent.group_llm_agent'))]"/>
    </record>

    <record id="rule_llm_memory_long_term_manager" model="ir.rule">
        <field name="name">LLM Long Term Memory: Managers see all memories</field>
        <field name="model_id" ref="model_llm_memory_long_term"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('llm_agent.group_llm_agent_manager'))]"/>
    </record>

    <!-- Record Rules for Short Term Memory -->
    <record id="rule_llm_memory_short_term_agent" model="ir.rule">
        <field name="name">LLM Short Term Memory: Agents see only their own memories</field>
        <field name="model_id" ref="model_llm_memory_short_term"/>
        <field name="domain_force">[('agent_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('llm_agent.group_llm_agent'))]"/>
    </record>

    <record id="rule_llm_memory_short_term_manager" model="ir.rule">
        <field name="name">LLM Short Term Memory: Managers see all memories</field>
        <field name="model_id" ref="model_llm_memory_short_term"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('llm_agent.group_llm_agent_manager'))]"/>
    </record>

    <!-- Record Rules for User Memory -->
    <record id="rule_llm_memory_user_own" model="ir.rule">
        <field name="name">LLM User Memory: Users see only their own memories</field>
        <field name="model_id" ref="model_llm_memory_user"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_llm_memory_user_manager" model="ir.rule">
        <field name="name">LLM User Memory: Managers see all memories</field>
        <field name="model_id" ref="model_llm_memory_user"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('llm_agent.group_llm_agent_manager'))]"/>
    </record>
</odoo>
