<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- AI Agent Category -->
        <record id="module_category_ai_agent" model="ir.module.category">
            <field name="name">AI Agents</field>
            <field name="description">Manage AI agents powered by LLM models</field>
            <field name="sequence">20</field>
        </record>

        <!-- AI Agent Group -->
        <record id="group_agent" model="res.groups">
            <field name="name">AI Agent</field>
            <field name="category_id" ref="module_category_ai_agent"/>
            <field name="comment">Users in this group are AI agents that can interact with other users through chat.</field>
            <field name="share">true</field>
        </record>

        <!-- Agent Manager Group -->
        <record id="group_agent_manager" model="res.groups">
            <field name="name">Agent Manager</field>
            <field name="category_id" ref="module_category_ai_agent"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Users in this group can manage AI agents.</field>
        </record>

        <!-- Record Rules -->
        <record id="agent_comp_rule" model="ir.rule">
            <field name="name">Agent: multi-company</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_agent'))]"/>
        </record>
    </data>

    <!-- Access Rights -->
    <data noupdate="1">
        <!-- Restrict agent access -->
        <record id="agent_access_restriction" model="ir.rule">
            <field name="name">Agents: restricted access</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="domain_force">[('is_agent', '=', False)]</field>
            <field name="groups" eval="[(4, ref('group_agent'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
