<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- LLM Agent Category -->
        <record id="module_category_llm_agent" model="ir.module.category">
            <field name="name">LLM Agents</field>
            <field name="description">Manage LLM agents powered by language models</field>
            <field name="sequence">20</field>
        </record>

        <!-- Groups -->
        <record id="group_llm_agent" model="res.groups">
            <field name="name">LLM Agent</field>
            <field name="category_id" ref="module_category_llm_agent"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Users in this group are LLM agents that can interact with other users through chat.</field>
        </record>

        <record id="group_llm_agent_manager" model="res.groups">
            <field name="name">LLM Agent Manager</field>
            <field name="category_id" ref="module_category_llm_agent"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Users in this group can manage LLM agents.</field>
        </record>

        <!-- Multi-company Rules -->
        <record id="agent_comp_rule" model="ir.rule">
            <field name="name">LLM Agent: multi-company</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_llm_agent'))]"/>
        </record>

        <!-- Allow reading agent fields for all users -->
        <record id="agent_read_rule" model="ir.rule">
            <field name="name">Users can read LLM agents and their own record</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="domain_force">['|', ('is_agent', '=', True), ('id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Manager access to agent fields -->
        <record id="agent_manager_rule" model="ir.rule">
            <field name="name">Managers can write LLM agent fields</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="domain_force">[('is_agent', '=', True)]</field>
            <field name="groups" eval="[(4, ref('group_llm_agent_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Agent Config Rules -->
        <record id="agent_config_rule_personal" model="ir.rule">
            <field name="name">Personal Agent Configs</field>
            <field name="model_id" ref="model_llm_agent_config"/>
            <field name="domain_force">[('user_id','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('group_llm_agent'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="agent_config_rule_manager" model="ir.rule">
            <field name="name">All Agent Configs</field>
            <field name="model_id" ref="model_llm_agent_config"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('group_llm_agent_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- LLM Agent Task Rules -->
        <record id="llm_agent_task_rule_personal" model="ir.rule">
            <field name="name">Personal Tasks</field>
            <field name="model_id" ref="model_llm_agent_task"/>
            <field name="domain_force">[('agent_id','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('group_llm_agent'))]"/>
        </record>

        <record id="llm_agent_task_rule_manager" model="ir.rule">
            <field name="name">All Tasks</field>
            <field name="model_id" ref="model_llm_agent_task"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('group_llm_agent_manager'))]"/>
        </record>
    </data>
</odoo>