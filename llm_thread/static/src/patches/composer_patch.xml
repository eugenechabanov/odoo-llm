<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <!-- Add a dictation mic next to the attach button, LLM threads only -->
    <t
    t-name="mail.Composer.attachFiles"
    t-inherit="mail.Composer.attachFiles"
    t-inherit-mode="extension"
  >
        <xpath expr="//FileUploader" position="after">
            <button
        t-if="showDictation"
        class="o-llm-Composer-dictate btn border-0 rounded-circle p-0"
        t-att-class="{ 'o-llm-recording': dictation.recording }"
        t-att-disabled="dictation.transcribing"
        t-att-title="dictationTitle"
        t-att-aria-label="dictationTitle"
        t-att-aria-pressed="dictation.recording"
        type="button"
        t-on-click="onClickDictate"
      >
                <i
          t-if="dictation.transcribing"
          class="fa fa-fw fa-lg fa-circle-o-notch fa-spin"
        />
                <i
          t-elif="dictation.recording"
          class="fa fa-fw fa-lg fa-stop"
        />
                <i t-else="" class="fa fa-fw fa-lg fa-microphone" />
            </button>
        </xpath>
    </t>

    <!-- Patch Composer send button template to add stop button for LLM threads -->
    <t
    t-name="mail.Composer.sendButton"
    t-inherit="mail.Composer.sendButton"
    t-inherit-mode="extension"
  >
        <!-- Replace the send button with conditional rendering -->
        <xpath
      expr="//button[hasclass('o-mail-Composer-send')]"
      position="replace"
    >
            <!-- Show stop button when streaming (LLM threads only) -->
            <button
        t-if="showStop"
        class="o-mail-Composer-send btn btn-danger"
        t-att-class="{
                    'btn-sm': extended,
                    'rounded-circle p-0': !extended,
                    'me-2': env.inDiscussApp,
                    'border-start-0': env.inDiscussApp and !props.composer.message,
                    'border-0': props.composer.message,
                }"
        t-on-click="stopStreaming"
        aria-label="Stop generation"
      >
                <i class="fa fa-fw fa-lg fa-stop" />
            </button>

            <!-- Show normal send button when not streaming -->
            <button
        t-else=""
        class="o-mail-Composer-send btn"
        t-att-class="{
                    'btn-primary btn-sm': extended,
                    'btn-link rounded-circle p-0': !extended,
                    'me-2': env.inDiscussApp,
                    'border-start-0': env.inDiscussApp and !props.composer.message,
                    'border-0': props.composer.message,
                }"
        t-on-click="sendMessage"
        t-att-disabled="isSendButtonDisabled"
        t-att-aria-label="SEND_TEXT"
      >
                <!-- LLM threads use the paper-plane icon like discuss.channel:
                     the round compact send button has no room for the word. -->
                <t
          t-if="thread and thread.model !== 'discuss.channel' and thread.model !== 'llm.thread'"
          t-out="SEND_TEXT"
        />
                <t t-else=""><i class="fa fa-fw fa-lg fa-paper-plane-o" /></t>
            </button>
        </xpath>
    </t>
</templates>
