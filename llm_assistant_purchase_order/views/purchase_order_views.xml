<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Add "Process with AI" button to purchase order form -->
    <record id="view_purchase_order_form_process_ai" model="ir.ui.view">
        <field name="name">purchase.order.form.process.ai</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="action_process_with_ai"
                    type="object"
                    string="Process with AI"
                    class="btn-primary"
                    attrs="{'invisible': [('state', 'not in', ('draft', 'sent'))]}"
                />
            </xpath>
        </field>
    </record>
</odoo>
