<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Scheduled task to check pending LLM jobs -->
        <record id="ir_cron_check_llm_pending_jobs" model="ir.cron">
            <field name="name">LLM: Check Pending Jobs</field>
            <field name="model_id" ref="model_llm_job_mixin"/>
            <field name="state">code</field>
            <field name="code">model.check_pending_jobs()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
