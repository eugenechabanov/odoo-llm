<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="llm_agent_view_form" model="ir.ui.view">
        <field name="name">llm.agent.form</field>
        <field name="model">llm.agent</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Agent Name"/>
                        </h1>
                    </div>
                    <group>
                        <group name="basic_info">
                            <field name="user_id"/>
                            <field name="role"/>
                            <field name="goal"/>
                            <field name="backstory"/>
                        </group>
                        <group name="llm_config">
                            <field name="llm_provider_id"/>
                            <field name="llm_model_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Team Structure" name="team">
                            <group>
                                <group>
                                    <field name="parent_id"/>
                                    <field name="is_manager"/>
                                </group>
                            </group>
                            <field name="member_ids" attrs="{'invisible': [('is_manager', '=', False)]}"/>
                        </page>
                        <page string="Tools" name="tools">
                            <field name="tool_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="llm_agent_view_tree" model="ir.ui.view">
        <field name="name">llm.agent.tree</field>
        <field name="model">llm.agent</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="user_id"/>
                <field name="role"/>
                <field name="llm_provider_id"/>
                <field name="llm_model_id"/>
                <field name="parent_id"/>
                <field name="is_manager"/>
            </tree>
        </field>
    </record>

    <!-- Search View -->
    <record id="llm_agent_view_search" model="ir.ui.view">
        <field name="name">llm.agent.search</field>
        <field name="model">llm.agent</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_id"/>
                <field name="role"/>
                <field name="llm_provider_id"/>
                <field name="llm_model_id"/>
                <field name="parent_id"/>
                <separator/>
                <filter string="Managers" name="managers" domain="[('is_manager', '=', True)]"/>
                <filter string="Team Members" name="team_members" domain="[('parent_id', '!=', False)]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="LLM Provider" name="group_by_provider" context="{'group_by': 'llm_provider_id'}"/>
                    <filter string="Manager" name="group_by_manager" context="{'group_by': 'parent_id'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
