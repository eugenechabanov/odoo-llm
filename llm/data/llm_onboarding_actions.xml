<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Server Action to Open Provider Creation Form -->
        <record id="action_open_llm_provider_form" model="ir.actions.server">
            <field name="name">LLM: Open Provider Form</field>
            <field name="model_id" ref="model_llm_provider"/> <!-- Target model doesn't matter much here, action is specific -->
            <field name="state">code</field>
            <field name="code">
# Return the action to open the provider form in 'new' mode
action = env.ref('llm.llm_provider_action').sudo().read()[0]
action['view_mode'] = 'form'
action['views'] = [(False, 'form')]
action['target'] = 'current' # Open in the main content area
action['context'] = {'default_name': 'New AI Provider'} # Pre-fill context if needed
action['res_id'] = False # Ensure it opens a new form
action = action
            </field>
        </record>

        <!-- Server Action to Launch the Fetch Models Tour -->
<record id="action_launch_fetch_models_tour" model="ir.actions.server">
    <field name="name">LLM: Launch Fetch Models Tour</field>
    <field name="model_id" ref="model_llm_provider"/>
    <field name="state">code</field>
    <field name="code">
action = {
    'type': 'ir.actions.client',
    # Use your custom tag registered in JS
    'tag': 'llm_run_tour',
    'params': {
        'tour_name': 'fetch_models_tour',
        'mode': 'onboarding',
        # Pass any other needed params here
    }
}
    </field>
</record>

        <!-- Server Action to Close the LLM Onboarding -->
