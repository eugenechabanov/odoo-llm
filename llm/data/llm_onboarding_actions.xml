        <!-- Server Action to Launch the Provider Configuration Tour -->
<record id="action_launch_configure_llm_provider_tour" model="ir.actions.server">
    <field name="name">LLM: Launch Provider Configuration Tour</field>
    <field name="model_id" ref="model_llm_provider"/>
    <field name="state">code</field>
    <field name="code">
